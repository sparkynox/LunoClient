<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0F26">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="380dp"
        android:layout_gravity="bottom|center_horizontal"
        android:src="@drawable/luno_char_welcome"
        android:adjustViewBounds="true"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to LunoClient"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="LunoClient is built on top of MojoLauncher's open source code, with a fresh anime-themed UI, extra features, and an optimization-first focus. Full credit to the original MojoLauncher (PojavLauncher) authors — this project wouldn't exist without their work."
            android:textColor="#CFC2E8"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <Button
        android:id="@+id/luno_welcome_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        android:text="Next" />

</FrameLayout>
